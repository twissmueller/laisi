{
  "name": "laisi",
  "version": "0.1.0",
  "description": "Let AI Supervise Itself — AI Workflow Harness with Schema Validation",
  "type": "module",
  "bin": {
    "laisi": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "files": [
    "dist/",
    "workflows/"
  ],
  "dependencies": {
    "fast-xml-parser": "^5.5.9",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "automation",
    "workflow",
    "claude",
    "xsd",
    "schema-validation"
  ],
  "license": "MIT"
}
