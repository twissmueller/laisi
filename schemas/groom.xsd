<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="groom">
    <xs:complexType>
      <xs:sequence>

        <!-- Meta -->
        <xs:element name="meta">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="issue" type="xs:integer"/>
              <xs:element name="title" type="xs:string"/>
              <xs:element name="date" type="xs:dateTime"/>
              <xs:element name="iteration" type="xs:integer"/>
              <xs:element name="status">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="updated"/>
                    <xs:enumeration value="no_new_tasks"/>
                    <xs:enumeration value="no_new_comments"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Seit wann (initial beim ersten Lauf, Timestamp bei Folgeläufen) -->
        <xs:element name="since" type="xs:string"/>

        <!-- Analysierte Kommentare (alle beim ersten Lauf, nur neue bei Folgeläufen) -->
        <xs:element name="new_comments">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="comment" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="author" type="xs:string" use="required"/>
                      <xs:attribute name="date" type="xs:string" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="count" type="xs:integer" use="required"/>
          </xs:complexType>
        </xs:element>

        <!-- Bestehende Tasks im Issue -->
        <xs:element name="existing_tasks">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="task" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="done" type="xs:boolean" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="count" type="xs:integer" use="required"/>
          </xs:complexType>
        </xs:element>

        <!-- Von Claude extrahierte Tasks -->
        <xs:element name="extracted_tasks">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="task" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="count" type="xs:integer" use="required"/>
          </xs:complexType>
        </xs:element>

        <!-- Ergebnis nach Merge/Deduplizierung -->
        <xs:element name="result">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="added">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="task" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                  </xs:sequence>
                  <xs:attribute name="count" type="xs:integer" use="required"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="duplicates_removed" type="xs:integer"/>
              <xs:element name="total_tasks" type="xs:integer"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
