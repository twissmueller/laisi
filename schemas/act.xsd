<?xml version="1.0" encoding="UTF-8"?>
<!-- TODO: Define act phase schema -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="act">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="meta">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="issue" type="xs:integer"/>
              <xs:element name="date" type="xs:dateTime"/>
              <xs:element name="iteration" type="xs:integer"/>
              <xs:element name="status">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="pr_created"/>
                    <xs:enumeration value="waiting_for_human"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!-- TODO: pr_url, merged_rules, updated_skills, etc. -->
        <xs:element name="handoff" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
